# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Replay mode needs none of these: the demo runs from runs/llm-cache/manifest.json.
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-me
# Optional; required when LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_MODEL_STRONG=replace-me
LLM_MODEL_FAST=replace-me
# Optional: run the fast tier on another provider (e.g. groq or a local model)
LLM_PROVIDER_FAST=
LLM_API_KEY_FAST=
LLM_MODE=replay

# Optional, for the provider-switch eval only: one model (and key) per extra provider you can test.
# Providers are anthropic, openai, gemini, groq, openrouter, ollama (no key), custom (needs a base URL).
# Unset ones are skipped. A profile without its own key reuses LLM_API_KEY only if it points at the same host.
LLM_SWITCH_CUSTOM_MODEL=
LLM_SWITCH_CUSTOM_BASE_URL=
LLM_SWITCH_CUSTOM_API_KEY=
LLM_SWITCH_ANTHROPIC_MODEL=
LLM_SWITCH_ANTHROPIC_API_KEY=
LLM_SWITCH_OPENAI_MODEL=
LLM_SWITCH_OPENAI_API_KEY=
LLM_SWITCH_GEMINI_MODEL=
LLM_SWITCH_GEMINI_API_KEY=
LLM_SWITCH_GROQ_MODEL=
LLM_SWITCH_GROQ_API_KEY=
LLM_SWITCH_OPENROUTER_MODEL=
LLM_SWITCH_OPENROUTER_API_KEY=
LLM_SWITCH_OLLAMA_MODEL=

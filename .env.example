# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Replay mode needs none of these: the demo runs from runs/llm-cache/manifest.json.
LLM_PROVIDER=anthropic
LLM_API_KEY=replace-me
# Optional; required when LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_MODEL_STRONG=replace-me
LLM_MODEL_FAST=replace-me
# Optional: run the fast tier on another provider (e.g. groq or a local model)
LLM_PROVIDER_FAST=
LLM_API_KEY_FAST=
LLM_MODE=replay

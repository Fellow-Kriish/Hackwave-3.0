node_modules/
dist/
*.tsbuildinfo

# Secrets: only the placeholder file is committed
.env
.env.*
!.env.example

# Shop runtime stores (recreated on first order or reset)
apps/shop/data/*.json

# Run folders stay local; the caches the engine learns from are committed
runs/*
!runs/plans/
!runs/locators/
!runs/llm-cache/
!runs/snapshots/
# hand-written plans heal into a scratch cache that is never committed
runs/locators/*.hand.json
# goals typed with `pnpm engine try` are scratch tests: their plan and locator caches stay local
runs/plans/typed-*.json
runs/locators/typed-*.json
# explore runs (any site, no verifier) are scratch too
runs/plans/explore-*.json
runs/locators/explore-*.json
# impeccable: per-developer settings and caches
.impeccable/config.local.json
.impeccable/hook.cache.json

test-results/
playwright-report/
.DS_Store
Thumbs.db
